      "path_patterns": [
        "databases.*.source_upper_watermarks",
        "databases.*.upper_watermarks"
      ],
      "container_type": "object"
    },
    {
      "id": "watermark_table_maps",
      "path_patterns": [
        "databases.*.source_upper_watermarks.*",
        "databases.*.upper_watermarks.*"
      ],
      "container_type": "object"
    },
    {
      "id": "safe_integer_maps",
      "path_patterns": [
        "database_budget_plan.database_budget_bytes",
