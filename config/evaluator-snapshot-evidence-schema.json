{
  "schema_version": "evaluator_snapshot_numeric_evidence.v3",
  "scope": "immutable_cross_db_evaluator_snapshot_manifest",
  "unknown_numeric_policy": "reject",
  "selector_policy": "explicit_path_or_field_with_parent_path_only",
  "path_syntax": "dot_segments_with_single_segment_wildcards_array_suffixes_and_root_dollar",
