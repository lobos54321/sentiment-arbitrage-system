{
  "schema_version": "evaluator_snapshot_numeric_evidence.v2",
  "scope": "immutable_cross_db_evaluator_snapshot_manifest",
  "unknown_numeric_policy": "reject",
  "selector_policy": "explicit_path_or_field_only",
  "path_syntax": "dot_segments_with_single_segment_wildcards_and_array_suffixes",
  "container_rules": [
    {
      "id": "watermark_database_maps",
      "path_patterns": [
        "databases.*.source_upper_watermarks",
        "databases.*.upper_watermarks"
      ],
      "container_type": "object"
    },
    {
      "id": "watermark_table_maps",
      "path_patterns": [
        "databases.*.source_upper_watermarks.*",
        "databases.*.upper_watermarks.*"
      ],
      "container_type": "object"
    },
    {
      "id": "safe_integer_maps",
      "path_patterns": [
        "database_budget_plan.database_budget_bytes",
        "database_budget_plan.padded_non_paper_estimate_bytes",
        "database_budget_plan.source_compact_estimate_bytes",
        "database_budget_plan.static_share_budget_bytes",
        "disk_preflight.temporary_parallel_paper_stage_cap_bytes"
      ],
      "container_type": "object",
      "element_kind": "safe_integer",
      "element_nullable": false,
      "element_minimum": 0
    },
    {
      "id": "finite_number_maps",
      "path_patterns": [
        "databases.*.parallel_paper_source_read_lock_duration_sec"
      ],
      "container_type": "object",
      "element_kind": "finite_number",
      "element_nullable": false,
      "element_minimum": 0,
      "element_maximum": 9007199254740991
    },
    {
      "id": "safe_integer_arrays",
      "path_patterns": [
        "selection_contract.supported_capture_windows_hours"
      ],
      "container_type": "array",
      "element_kind": "safe_integer",
      "element_nullable": false,
      "element_minimum": 0
    }
  ],
  "scalar_rules": [
    {
      "id": "signed_advisory_delta_bytes",
      "fields": [
        "advisory_delta_bytes"
      ],
      "kind": "safe_integer",
      "nullable": false
    },
    {
      "id": "nullable_signed_source_rowids",
      "fields": [
        "source_copy_rowid_lower",
        "source_copy_rowid_upper"
      ],
      "kind": "safe_integer",
      "nullable": true
    },
    {
      "id": "nullable_source_rowid_span",
      "fields": [
        "source_copy_rowid_span"
      ],
      "kind": "safe_integer",
      "nullable": true,
      "minimum": 0
    },
    {
