        "databases.raw.source_upper_watermarks.raw_signal_outcomes.signal_id",
        "databases.raw.upper_watermarks.raw_signal_outcomes.signal_id"
      ],
      "kind": "safe_integer_or_decimal_identifier",
      "nullable": true,
      "null_policy": "watermark_table_may_be_null_only_when_rows_copied_zero",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    {
      "id": "nullable_watermark_identifiers",
      "path_patterns": [
        "databases.*.source_upper_watermarks.*.id",
        "databases.*.source_upper_watermarks.*.signal_id",
        "databases.*.upper_watermarks.*.id",
        "databases.*.upper_watermarks.*.signal_id"
      ],
      "kind": "safe_integer",
      "nullable": true,
      "null_policy": "watermark_table_may_be_null_only_when_rows_copied_zero",
      "minimum": 0
